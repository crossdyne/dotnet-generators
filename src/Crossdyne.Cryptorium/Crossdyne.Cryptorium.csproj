<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0</Version>
    <Description>High-performance .NET utilities and Generators for secure creation of cryptographic primitives. Generate strong passwords, encryption keys, salts, and secure tokens with zero-allocation patterns and modern .NET security best practices.</Description>
    <PackageTags>dotnet; cryptography; security; password-generator; encryption-keys; secure-random; tokens; salts; zero-allocation; crossdyne</PackageTags>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  
  <ItemGroup>
    <InternalsVisibleTo Include="Crossdyne.Cryptorium.Unit.Tests" />
  </ItemGroup>
</Project>
